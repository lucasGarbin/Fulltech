# Copie para .env e preencha. NUNCA faça commit do .env.

PORT=5000

# Origens do frontend autorizadas (CORS), separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Conta Gmail que ENVIA os e-mails + "Senha de app" de 16 caracteres
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Quem RECEBE as mensagens (se vazio, usa GMAIL_USER)
MAIL_TO=contato@fulltechequipamentos.com.br

# Tamanho máximo do anexo do chamado (MB)
MAX_FILE_MB=10

# ----- Administração de catálogos (acesso em  /#/admin ) -----
# Senha de acesso ao painel (use uma senha longa)
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Segredo para assinar a sessão (texto aleatório longo; opcional)
ADMIN_SECRET=
# Tamanho máximo de cada PDF de catálogo (MB)
MAX_PDF_MB=20
